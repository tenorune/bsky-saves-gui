{
  "name": "bsky-saves-gui",
  "version": "0.0.0",
  "private": true,
  "description": "Web GUI for bsky-saves (working title: BlueSky Saves Exporter)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
